{
  "name": "backend",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "fmt": "prettier --write \"src/**/*.{ts,js}\" \"test/**/*.{ts,js}\" \"*.js\"",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --project demo-project --import testdata ",
    "serve:export": "npm run build && firebase emulators:start --project demo-project --import testdata --export-on-exit",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log",
    "seed": "node seed.js",
    "test": "mocha -r ts-node/register 'test/**/*.test.ts' --timeout 10000"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "firebase-admin": "^13.7.0",
    "firebase-functions": "^7.3.2",
    "marked": "^17.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/marked": "^5.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.19.15",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "eslint": "^8.57.1",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.25.4",
    "firebase-functions-test": "^3.4.1",
    "mocha": "^10.8.2",
    "prettier": "^2.8.8",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true
}
