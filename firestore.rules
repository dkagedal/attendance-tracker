rules_version = '2';

// ===============================================================
// Assumed Data Model (see specs/0002-firestore-data-model.md)
// ===============================================================
//
// Collection: /users/{user}
//   - bands: map (bandId -> { display_name: string })
//   Subcollection: /users/{user}/apikeys/{key}
//     - name: string, createdAt: timestamp, readonly: bool
//
// Collection: /hosts/{hostname}
//   - band: string (custom hostname mapping, publicly readable by get)
//
// Collection: /bands/{band}
//   - display_name: string, logo?: string, timezone?: string, sections?: list
//   Document: /bands/{band}/admin/nextcloud
//     - Backend-only (no client access)
//   Subcollection: /bands/{band}/join_requests/{user}
//     - display_name: string, url: string, approved: bool
//   Subcollection: /bands/{band}/members/{uid}
//     - display_name: string, admin: bool, section_id?: string
//     Document: /bands/{band}/members/{uid}/private/settings
//       - email: string, notify: map
//     Document: /bands/{band}/members/{uid}/private/calendar
//       - secret: string (required, length 16..256)
//       - createdAt: timestamp (required)
//   Subcollection: /bands/{band}/events/{event}
//     - type: string, start: string, stop?: string, location?: string,
//       description?: string, cancelled?: bool
//     Subcollection: /bands/{band}/events/{event}/participants/{participant}
//       - attending: string, comment?: string
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================

    // Check if the user is authenticated.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if the request is authenticated as uid.
    function authenticatedAs(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Validate required fields exist on a map/document.
    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    // Validate that a map/document contains only allowed fields.
    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    // Validate schema for /bands/{band}/members/{uid}/private/calendar.
    function isValidCalendarDoc(data) {
      return hasRequiredFields(data, ['secret', 'createdAt']) &&
        hasOnlyAllowedFields(data, ['secret', 'createdAt']) &&
        data.secret is string &&
        data.secret.size() >= 16 &&
        data.secret.size() <= 256 &&
        data.createdAt is timestamp;
    }

    // Is the given user known to this application?
    function isUser(uid) {
        let user = /databases/$(database)/documents/users/$(uid);
        return exists(user);
    }

    // Users collection.
    match /users/{user} {
			allow read: if request.auth.uid == user;
      allow create: if request.auth.uid == user;
      allow update: if request.auth.uid == user && request.resource.data == resource.data;
      allow delete: if false;

      match /apikeys/{key} {
        allow read, write: if request.auth.uid == user;
      }
    }

    // Hosts collection.
    match /hosts/{hostname} {
      allow get: if true;
    }

    match /bands/{band} {
      allow list: if false;
			allow get: if true;
			allow update: if isMember(request.auth.uid) && isAdmin(request.auth.uid);
      allow create, delete: if false;

      // Is the given user a member of this band?
      function isMember(uid) {
        let member = /databases/$(database)/documents/bands/$(band)/members/$(uid);
        return exists(member);
      }

      // Is the given user an admin for this band?
      function isAdmin(uid) {
        let member = /databases/$(database)/documents/bands/$(band)/members/$(uid);
        return exists(member) && get(member).data.admin;
      }

      match /join_requests/{user} {
        allow list: if isAdmin(request.auth.uid);
        allow get: if request.auth.uid == user || isAdmin(request.auth.uid);
        allow create: if (request.resource.id == request.auth.uid 
                          && !isMember(request.auth.uid)
                          && isUser(request.auth.uid)
                          && !request.resource.data.approved);
        allow update: if isAdmin(request.auth.uid);
        allow delete: if isAdmin(request.auth.uid);
      }

      match /members/{uid} {
        allow read: if isMember(request.auth.uid);
        allow create, delete: if false;

        allow update: if
          (request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name'])) ||
          (isAdmin(request.auth.uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['display_name', 'section_id']));

        match /private/settings {
          allow read: if request.auth.uid == uid;
          allow write: if request.auth.uid == uid;
        }

        match /private/calendar {
          allow read: if authenticatedAs(uid) && isMember(request.auth.uid);
          allow create: if authenticatedAs(uid) && isMember(request.auth.uid) && isValidCalendarDoc(request.resource.data);
          allow update: if authenticatedAs(uid) && isMember(request.auth.uid) && isValidCalendarDoc(request.resource.data);
          allow delete: if authenticatedAs(uid) && isMember(request.auth.uid);
        }
      }

    	match /events/{event} {
        allow read, write: if isMember(request.auth.uid);

        match /participants/{participant} {
          allow read: if isMember(request.auth.uid);
          allow write: if request.resource.id == request.auth.uid && isMember(request.auth.uid);
        }
      }
    }
  }
} 
